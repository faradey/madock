[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4

[mysqld]
optimizer_switch = 'rowid_filter=off'
optimizer_use_condition_selectivity = 1

innodb_file_per_table = 1
collation-server = utf8mb4_unicode_ci
init-connect='SET NAMES utf8mb4'
character-set-server = utf8mb4
wait_timeout=30000
innodb_buffer_pool_size = 512M
innodb_log_buffer_size = 256M
innodb_write_io_threads = 16
innodb_flush_log_at_trx_commit = 0
log_bin_trust_function_creators = 1
max_allowed_packet = 64M

# The slow query log, which was never configured at all: `log_slow_query`,
# `general_log` and `log_error` are all commented out in the shipped config, so
# a slow query on any madock project has never been recorded anywhere.
#
# It writes into the data directory rather than a log directory of its own, and
# that is the whole reason it needs nothing else: `/var/lib/mysql` is already the
# `dbdata` volume, so the file survives a rebuild by itself. A path outside it
# would be a directory that does not exist unless something mounts one — and a
# mysqld that cannot open its slow log does not start.
#
# `log_error` stays on stderr deliberately. MariaDB writes it to a file or to
# the stream, never both, and the stream is what `madock logs -s db` reads.
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/mysql-slow.log
long_query_time = 2


sql_mode=NO_ENGINE_SUBSTITUTION,STRICT_TRANS_TABLES
