<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared by every platform.

  <tool>   a tool every platform gets unless its own file defines it.
  <offer>  what setup's menu lists for a service, newest first. The menu also
           shows the default the matrix gives, whether or not it is listed
           here, so a default can never be out of reach. "Custom" is added by
           the menu itself where a free value makes sense.
-->
<platform name="common">
    <tool name="xdebug" by="php">
        <when from="8.5">3.5.0</when>
        <when from="8.4">3.4.4</when>
        <when from="8.3">3.3.1</when>
        <when from="8.1">3.2.2</when>
        <when from="7.2">3.1.6</when>
        <default>2.7.2</default>
    </tool>

