<?xml version="1.0" encoding="UTF-8"?>
<!--
  6.5 checked against developer.shopware.com/docs/v6.5/guides/installation/requirements.html
  on 2026-10-15: PHP 8.1–8.3 supported, 8.2 recommended; MariaDB at least 10.11
  recommended. 6.6 and later keep PHP 8.3 — not re-checked.
-->
<config>
    <name>shopware</name>
    <tools>
        <language>
            <default>php</default>
        </language>
        <php>
            <rule><from>6.6</from><value>8.3</value></rule>
            <rule><from>6.5</from><value>8.2</value></rule>
            <rule><from>6.4</from><value>8.1</value></rule>
        </php>
        <db>
            <rule><from>6.5</from><value>10.11</value></rule>
            <rule><from>6.4</from><value>10.5</value></rule>
        </db>
        <searchengine>
            <rule><from>6.5</from><value>OpenSearch</value></rule>
            <default>Elasticsearch</default>
        </searchengine>
        <elastic>
            <rule><from>6.5</from><value>8.11.14</value></rule>
            <rule><from>6.4</from><value>8.4.3</value></rule>
        </elastic>
        <opensearch>
            <rule><from>6.5</from><value>2.8.0</value></rule>
            <rule><from>6.4</from><value>2.5.0</value></rule>
        </opensearch>
        <composer>
            <rule><from>6.3</from><value>2</value></rule>
        </composer>
        <redis>
            <rule><from>6.5</from><value>7.2</value></rule>
        </redis>
        <valkey>
            <default>8.1.3</default>
        </valkey>
        <rabbitmq>
            <rule><from>6.3</from><value>3.13</value></rule>
        </rabbitmq>
        <nodejs>
            <default>20.16.0</default>
        </nodejs>
        <yarn>
            <default>3.6.4</default>
        </yarn>
    </tools>
    <presets>
        <preset>
            <version>6.5</version>
            <name>Shopware 6.5</name>
            <description>PHP {php}, MariaDB {db}, OpenSearch {opensearch}</description>
        </preset>
    </presets>
</config>
