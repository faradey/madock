<?xml version="1.0" encoding="UTF-8"?>
<!--
  Checked on 2026-10-15. Medusa 2.x: @medusajs/medusa declares
  "engines": {"node": ">=22.22.0"}; the docs say v20.19+ or v22.12+. Medusa 1.x
  declares >=16. PostgreSQL and Redis versions are not stated by Medusa, so the
  values chosen for the presets stay. Medusa does not use RabbitMQ at all — its
  event bus is BullMQ on Redis — so no stack here carries one.
-->
<config>
    <name>medusa</name>
    <tools>
        <language>
            <default>nodejs</default>
        </language>
        <dbtype>
            <default>PostgreSQL</default>
        </dbtype>
        <db>
            <rule><version>2</version><value>postgres:17</value></rule>
            <rule><version>1</version><value>postgres:14.13</value></rule>
            <default>postgres:16.4</default>
        </db>
        <redis>
            <rule><version>2</version><value>7.4</value></rule>
            <rule><version>1</version><value>7.0</value></rule>
            <default>7.2.1</default>
        </redis>
        <nodejs>
            <rule><version>2</version><value>22.22.0</value></rule>
            <rule><version>1</version><value>18.20.0</value></rule>
            <!-- the docs' floor for 2.x: v20.19+ -->
            <default>20.19.0</default>
        </nodejs>
        <yarn>
            <rule><version>1</version><value>1.22.22</value></rule>
            <default>4.5.0</default>
        </yarn>
    </tools>
    <presets>
        <preset>
            <version>2</version>
            <name>Medusa 2.x (Latest)</name>
            <description>Latest Medusa.js v2 with Node {nodejs}, PostgreSQL 17, Redis {redis}</description>
        </preset>
        <preset>
            <version>2.0</version>
            <name>Medusa 2.0 (Stable)</name>
            <description>Medusa.js v2 baseline with Node {nodejs}, PostgreSQL 16, Redis {redis}</description>
        </preset>
        <preset>
            <version>1</version>
            <name>Medusa 1.x (Legacy)</name>
            <description>Medusa.js v1 with Node {nodejs}, PostgreSQL 14, Redis {redis}</description>
        </preset>
    </presets>
</config>
