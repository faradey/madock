<?xml version="1.0" encoding="UTF-8"?>
<!--
  Saleor states no versions. Its official saleor-platform compose files
  (checked 2026-10-15) run postgres:15 for 3.20 and 3.23, redis:7.0 for 3.20,
  and valkey 8.1 for 3.23 — the 3.23 stack keeps Redis 7.2, which Saleor's
  Redis client speaks the same way.
-->
<config>
    <name>saleor</name>
    <tools>
        <language>
            <default>python</default>
        </language>
        <python>
            <default>3.12</default>
        </python>
        <dbtype>
            <default>PostgreSQL</default>
        </dbtype>
        <db>
            <default>postgres:15</default>
        </db>
        <redis>
            <rule><from>3.23</from><value>7.2.5</value></rule>
            <rule><from>3.20</from><value>7.0</value></rule>
            <default>7.2.5</default>
        </redis>
    </tools>
    <presets>
        <preset>
            <version>3.23</version>
            <name>Saleor 3.23 (Latest)</name>
            <description>Saleor 3.23.x with Python {python}, PostgreSQL 15, Redis {redis}</description>
        </preset>
        <preset>
            <version>3.20</version>
            <name>Saleor 3.20 (Stable)</name>
            <description>Saleor 3.20.x with Python {python}, PostgreSQL 15, Redis {redis}</description>
        </preset>
    </presets>
</config>
