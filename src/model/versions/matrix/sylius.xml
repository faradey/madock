<?xml version="1.0" encoding="UTF-8"?>
<!--
  Node checked on 2026-10-15: Sylius 1.13 supports Node 18.x and 20.x
  (old-docs.sylius.com/en/1.13/book/installation/requirements.html), Sylius 2.x
  ^20 || ^22 (docs.sylius.com). Versions before 1.13 keep Node 22 — not re-checked.
-->
<config>
    <name>sylius</name>
    <tools>
        <language>
            <default>php</default>
        </language>
        <php>
            <rule><from>2.0</from><value>8.3</value></rule>
            <rule><from>1.13</from><value>8.2</value></rule>
            <rule><from>1.12</from><value>8.1</value></rule>
            <default>8.3</default>
        </php>
        <db>
            <rule><from>2.0</from><value>mariadb:11.4</value></rule>
            <rule><from>1.13</from><value>mariadb:10.11</value></rule>
            <default>mariadb:10.6</default>
        </db>
        <composer>
            <default>2</default>
        </composer>
        <redis>
            <rule><from>2.0</from><value>7.4</value></rule>
            <default>7.2</default>
        </redis>
        <nodejs>
            <rule><from>2.0</from><value>22.20.0</value></rule>
            <rule><from>1.13</from><value>20.16.0</value></rule>
            <default>22.20.0</default>
        </nodejs>
        <yarn>
            <default>1.22.22</default>
        </yarn>
    </tools>
    <presets>
        <preset>
            <version>2.0</version>
            <name>Sylius 2.0 (Latest)</name>
            <description>Sylius 2.0.x with PHP {php}, {db}, Redis {redis}, Node {nodejs}, Yarn</description>
        </preset>
        <preset>
            <version>1.13</version>
            <name>Sylius 1.13 (Stable)</name>
            <description>Sylius 1.13.x with PHP {php}, {db}, Redis {redis}, Node {nodejs}</description>
        </preset>
    </presets>
</config>
