<?xml version="1.0" encoding="UTF-8"?>
<!-- python, golang and ruby come from the languages package, which knows
     them for every language madock supports. -->
<config>
    <name>custom</name>
    <tools>
        <language>
            <default>php</default>
        </language>
        <php>
            <default>8.2</default>
        </php>
        <db>
            <default>10.6</default>
        </db>
        <searchengine>
            <default>Elasticsearch</default>
        </searchengine>
        <elasticsearch>
            <default>8.4.3</default>
        </elasticsearch>
        <opensearch>
            <default>2.5.0</default>
        </opensearch>
        <composer>
            <default>2</default>
        </composer>
        <redis>
            <default>7.0</default>
        </redis>
        <valkey>
            <default>8.1.3</default>
        </valkey>
        <rabbitmq>
            <default>3.9</default>
        </rabbitmq>
    </tools>
</config>
