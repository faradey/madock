<?xml version="1.0" encoding="UTF-8"?>
<!-- python, golang and ruby come from the languages package, which knows
     them for every language madock supports. -->
<platform name="custom">
    <tool name="language"><default>php</default></tool>
    <tool name="php"><default>8.2</default></tool>
    <tool name="db"><default>10.6</default></tool>
    <tool name="searchengine"><default>Elasticsearch</default></tool>
    <tool name="elastic"><default>8.4.3</default></tool>
    <tool name="opensearch"><default>2.5.0</default></tool>
    <tool name="composer"><default>2</default></tool>
    <tool name="redis"><default>7.0</default></tool>
    <tool name="valkey"><default>8.1.3</default></tool>
    <tool name="rabbitmq"><default>3.9</default></tool>
</platform>
