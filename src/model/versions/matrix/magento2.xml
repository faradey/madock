<?xml version="1.0" encoding="UTF-8"?>
<!--
  Checked against Adobe's system requirements on 2026-10-15
  (experienceleague.adobe.com/en/docs/commerce-operations/installation-guide/system-requirements).
  Each line is the newest version Adobe supports for that release. Patch lines
  (-pN) sit below the next minor's rules: 2.4.6-p11 is earlier than 2.4.7.
-->
<config>
    <name>magento2</name>
    <tools>
        <language>
            <default>php</default>
        </language>
        <php>
            <rule><from>2.4.9</from><value>8.5</value></rule>
            <rule><from>2.4.8</from><value>8.4</value></rule>
            <rule><from>2.4.7</from><value>8.3</value></rule>
            <rule><from>2.4.6</from><value>8.2</value></rule>
            <rule><from>2.4.4</from><value>8.1</value></rule>
            <rule><from>2.3.7</from><value>7.4</value></rule>
            <rule><from>2.3.3</from><value>7.3</value></rule>
            <rule><from>2.3.0</from><value>7.2</value></rule>
            <rule><from>2.2.0</from><value>7.1</value></rule>
            <rule><from>2.0.0</from><value>7.0</value></rule>
        </php>
        <db>
            <rule><from>2.4.9</from><value>11.8</value></rule>
            <rule><from>2.4.8</from><value>11.4</value></rule>
            <rule><from>2.4.7</from><value>10.6</value></rule>
            <rule><from>2.4.6-p11</from><value>10.11</value></rule>
            <rule><from>2.4.6</from><value>10.6</value></rule>
            <rule><from>2.4.1</from><value>10.4</value></rule>
            <rule><from>2.3.7</from><value>10.3</value></rule>
            <rule><from>2.3.0</from><value>10.2</value></rule>
            <rule><from>2.0.0</from><value>10.0</value></rule>
        </db>
        <searchengine>
            <rule><from>2.4.6</from><value>OpenSearch</value></rule>
            <default>Elasticsearch</default>
        </searchengine>
        <elasticsearch>
            <rule><from>2.4.8</from><value>8.17.6</value></rule>
            <rule><from>2.4.7</from><value>8.11.14</value></rule>
            <rule><from>2.4.6</from><value>8.4.3</value></rule>
            <rule><from>2.4.5</from><value>7.17.5</value></rule>
            <rule><from>2.4.4</from><value>7.16.3</value></rule>
            <rule><from>2.4.3</from><value>7.10.1</value></rule>
            <rule><from>2.4.2</from><value>7.9.3</value></rule>
            <rule><from>2.4.1</from><value>7.7.1</value></rule>
            <rule><from>2.4.0</from><value>7.6.2</value></rule>
            <rule><from>2.3.7</from><value>7.9.3</value></rule>
            <rule><from>2.3.6</from><value>7.7.1</value></rule>
            <rule><from>2.3.5</from><value>7.6.2</value></rule>
            <rule><from>2.0.0</from><value>6.8.13</value></rule>
        </elasticsearch>
        <opensearch>
            <rule><from>2.4.9</from><value>3.0.0</value></rule>
            <rule><from>2.4.8</from><value>2.19.0</value></rule>
            <rule><from>2.4.7</from><value>2.12.0</value></rule>
            <rule><from>2.4.6-p10</from><value>2.19.0</value></rule>
            <rule><from>2.4.6-p5</from><value>2.12.0</value></rule>
            <rule><from>2.4.6</from><value>2.5.0</value></rule>
            <rule><from>2.4.3-p2</from><value>1.2.0</value></rule>
            <rule><version>2.3.7-p4</version><value>1.2.0</value></rule>
            <rule><version>2.3.7-p3</version><value>1.2.0</value></rule>
            <default>NotCompatible</default>
        </opensearch>
        <composer>
            <rule><from>2.4.2</from><value>2</value></rule>
            <rule><from>2.4.0</from><value>1</value></rule>
            <rule><from>2.3.7</from><value>2</value></rule>
            <rule><from>2.0.0</from><value>1</value></rule>
        </composer>
        <redis>
            <rule><from>2.4.8</from><value>8.0</value></rule>
            <rule><from>2.4.7</from><value>7.2</value></rule>
            <rule><from>2.4.6-p8</from><value>7.2</value></rule>
            <rule><from>2.4.6</from><value>7.0</value></rule>
            <rule><from>2.4.4</from><value>6.2</value></rule>
            <rule><from>2.4.2</from><value>6.0</value></rule>
            <rule><from>2.4.0</from><value>5.0</value></rule>
            <rule><from>2.3.7</from><value>6.0</value></rule>
            <rule><from>2.0.0</from><value>5.0</value></rule>
        </redis>
        <valkey>
            <rule><from>2.4.9</from><value>9.0.0</value></rule>
            <default>8.1.3</default>
        </valkey>
        <rabbitmq>
            <rule><from>2.4.9</from><value>4.2</value></rule>
            <rule><from>2.4.7-p5</from><value>4.1</value></rule>
            <rule><from>2.4.7</from><value>3.13</value></rule>
            <rule><from>2.4.6-p10</from><value>4.1</value></rule>
            <rule><from>2.4.6-p7</from><value>3.13</value></rule>
            <rule><from>2.4.6</from><value>3.11</value></rule>
            <rule><from>2.4.4</from><value>3.9</value></rule>
            <rule><from>2.3.4</from><value>3.8</value></rule>
            <rule><from>2.0.0</from><value>3.7</value></rule>
        </rabbitmq>
        <nodejs>
            <default>18.15.0</default>
        </nodejs>
        <yarn>
            <default>3.6.4</default>
        </yarn>
    </tools>
    <presets>
        <preset>
            <version>2.4.9</version>
            <name>Magento 2.4.9 (Latest)</name>
            <description>Latest stable with PHP {php}, OpenSearch {opensearch}, Redis {redis}, MariaDB {db}</description>
        </preset>
        <preset>
            <version>2.4.8</version>
            <name>Magento 2.4.8 (Previous)</name>
            <description>Previous stable with PHP {php}, OpenSearch {opensearch}, Redis {redis}</description>
        </preset>
        <preset>
            <version>2.4.7</version>
            <name>Magento 2.4.7 (Stable)</name>
            <description>Stable release with PHP {php}, OpenSearch {opensearch}, Redis {redis}</description>
        </preset>
        <preset>
            <version>2.4.6-p4</version>
            <name>Magento 2.4.6-p4 (LTS)</name>
            <description>Long-term support with PHP {php}, OpenSearch {opensearch}, MariaDB {db}</description>
        </preset>
        <preset>
            <version>2.4.5</version>
            <name>Magento 2.4.5 (Legacy)</name>
            <description>Older stable with PHP {php}, Elasticsearch {elasticsearch}</description>
        </preset>
    </presets>
</config>
