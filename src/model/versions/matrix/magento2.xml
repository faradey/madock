<?xml version="1.0" encoding="UTF-8"?>
<!--
  Checked against Adobe's system requirements on 2026-10-15
  (experienceleague.adobe.com/en/docs/commerce-operations/installation-guide/system-requirements).
  Each line is the newest version Adobe supports for that release. Patch lines
  (-pN) sit below the next minor's rules: 2.4.6-p11 is earlier than 2.4.7.
-->
<platform name="magento2">
    <tool name="language"><default>php</default></tool>
    <tool name="php">
        <when from="2.4.9">8.5</when>
        <when from="2.4.8">8.4</when>
        <when from="2.4.7">8.3</when>
        <when from="2.4.6">8.2</when>
        <when from="2.4.4">8.1</when>
        <when from="2.3.7">7.4</when>
        <when from="2.3.3">7.3</when>
        <when from="2.3.0">7.2</when>
        <when from="2.2.0">7.1</when>
        <when from="2.0.0">7.0</when>
    </tool>
    <tool name="db">
        <when from="2.4.9">11.8</when>
        <when from="2.4.8">11.4</when>
        <when from="2.4.7">10.6</when>
        <when from="2.4.6-p11">10.11</when>
        <when from="2.4.6">10.6</when>
        <when from="2.4.1">10.4</when>
        <when from="2.3.7">10.3</when>
        <when from="2.3.0">10.2</when>
        <when from="2.0.0">10.0</when>
    </tool>
    <tool name="searchengine">
        <when from="2.4.6">OpenSearch</when>
        <default>Elasticsearch</default>
    </tool>
    <tool name="elastic">
        <when from="2.4.8">8.17.6</when>
        <when from="2.4.7">8.11.14</when>
        <when from="2.4.6">8.4.3</when>
        <when from="2.4.5">7.17.5</when>
        <when from="2.4.4">7.16.3</when>
        <when from="2.4.3">7.10.1</when>
        <when from="2.4.2">7.9.3</when>
        <when from="2.4.1">7.7.1</when>
        <when from="2.4.0">7.6.2</when>
        <when from="2.3.7">7.9.3</when>
        <when from="2.3.6">7.7.1</when>
        <when from="2.3.5">7.6.2</when>
        <when from="2.0.0">6.8.13</when>
    </tool>
    <tool name="opensearch">
        <when from="2.4.9">3.0.0</when>
        <when from="2.4.8">2.19.0</when>
        <when from="2.4.7">2.12.0</when>
        <when from="2.4.6-p10">2.19.0</when>
        <when from="2.4.6-p5">2.12.0</when>
        <when from="2.4.6">2.5.0</when>
        <when from="2.4.3-p2">1.2.0</when>
        <when version="2.3.7-p4">1.2.0</when>
        <when version="2.3.7-p3">1.2.0</when>
        <default>NotCompatible</default>
    </tool>
    <tool name="composer">
        <when from="2.4.2">2</when>
        <when from="2.4.0">1</when>
        <when from="2.3.7">2</when>
        <when from="2.0.0">1</when>
    </tool>
    <tool name="redis">
        <when from="2.4.8">8.0</when>
        <when from="2.4.7">7.2</when>
        <when from="2.4.6-p8">7.2</when>
        <when from="2.4.6">7.0</when>
        <when from="2.4.4">6.2</when>
        <when from="2.4.2">6.0</when>
        <when from="2.4.0">5.0</when>
        <when from="2.3.7">6.0</when>
        <when from="2.0.0">5.0</when>
    </tool>
    <tool name="valkey">
        <when from="2.4.9">9.0.0</when>
        <default>8.1.3</default>
    </tool>
    <tool name="rabbitmq">
        <when from="2.4.9">4.2</when>
        <when from="2.4.7-p5">4.1</when>
        <when from="2.4.7">3.13</when>
        <when from="2.4.6-p10">4.1</when>
        <when from="2.4.6-p7">3.13</when>
        <when from="2.4.6">3.11</when>
        <when from="2.4.4">3.9</when>
        <when from="2.3.4">3.8</when>
        <when from="2.0.0">3.7</when>
    </tool>
    <tool name="nodejs"><default>18.15.0</default></tool>
    <tool name="yarn"><default>3.6.4</default></tool>

    <preset version="2.4.9" name="Magento 2.4.9 (Latest)" description="Latest stable with PHP {php}, OpenSearch {opensearch}, Redis {redis}, MariaDB {db}"/>
    <preset version="2.4.8" name="Magento 2.4.8 (Previous)" description="Previous stable with PHP {php}, OpenSearch {opensearch}, Redis {redis}"/>
    <preset version="2.4.7" name="Magento 2.4.7 (Stable)" description="Stable release with PHP {php}, OpenSearch {opensearch}, Redis {redis}"/>
    <preset version="2.4.6-p4" name="Magento 2.4.6-p4 (LTS)" description="Long-term support with PHP {php}, OpenSearch {opensearch}, MariaDB {db}"/>
    <preset version="2.4.5" name="Magento 2.4.5 (Legacy)" description="Older stable with PHP {php}, Elasticsearch {elastic}"/>
</platform>
