<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigCommerce has no platform version; the "version" is the stack flavour a
  preset picks: catalyst, stencil, api-php, app-node. An empty value is a
  service that flavour does not run. Without a flavour the baseline applies.

  Checked on 2026-10-15: "Catalyst supports Node.js version 24.x"
  (docs.bigcommerce.com/developer/docs/storefront/catalyst/development/prerequisites).
-->
<config>
    <name>bigcommerce</name>
    <tools>
        <language>
            <rule><version>api-php</version><value>php</value></rule>
            <default>nodejs</default>
        </language>
        <nodejs>
            <rule><version>catalyst</version><value>24.10.0</value></rule>
            <rule><version>api-php</version><value/></rule>
            <default>22.20.0</default>
        </nodejs>
        <yarn>
            <rule><version>api-php</version><value/></rule>
            <default>1.22.22</default>
        </yarn>
        <php>
            <rule><version>catalyst</version><value/></rule>
            <rule><version>stencil</version><value/></rule>
            <rule><version>app-node</version><value/></rule>
            <default>8.3</default>
        </php>
        <db>
            <rule><version>catalyst</version><value/></rule>
            <rule><version>stencil</version><value/></rule>
            <rule><version>app-node</version><value/></rule>
            <default>mariadb:11.4</default>
        </db>
        <composer>
            <rule><version>catalyst</version><value/></rule>
            <rule><version>stencil</version><value/></rule>
            <rule><version>app-node</version><value/></rule>
            <default>2</default>
        </composer>
        <redis>
            <rule><version>catalyst</version><value/></rule>
            <rule><version>stencil</version><value/></rule>
            <rule><version>app-node</version><value/></rule>
            <default>7.4</default>
        </redis>
        <!-- No Xdebug in these stacks: no rules means it answers nothing. -->
        <xdebug>
            <by>php</by>
        </xdebug>
    </tools>
    <presets>
        <preset>
            <version>catalyst</version>
            <name>Catalyst (Next.js storefront)</name>
            <description>Official headless storefront — Next.js + TypeScript, Tailwind. Node {nodejs}.</description>
        </preset>
        <preset>
            <version>stencil</version>
            <name>Stencil theme (Node + Handlebars)</name>
            <description>Legacy theme dev with @bigcommerce/stencil-cli — Cornerstone-based themes, Handlebars templates. Node {nodejs}.</description>
        </preset>
        <preset>
            <version>api-php</version>
            <name>PHP API SDK (bigcommerce/api)</name>
            <description>Backend integration via the official bigcommerce/api Composer package. PHP {php}, MariaDB, Redis.</description>
        </preset>
        <preset>
            <version>app-node</version>
            <name>Node App (Express / Next.js)</name>
            <description>Embedded App Marketplace template — Express + Next.js + OAuth handshake. Node {nodejs}.</description>
        </preset>
    </presets>
</config>
