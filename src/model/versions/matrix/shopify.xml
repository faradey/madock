<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shopify has no platform version; the "version" is the stack flavour a preset
  picks: hydrogen, app-remix, api-php, laravel-shopify. An empty value is a
  service that flavour does not run. Without a flavour the baseline applies.

  Checked on 2026-10-15: Hydrogen wants Node 22.12+ or 24.x
  (shopify.dev/docs/storefronts/headless/hydrogen/getting-started); the app
  template >=20.19 <22 || >=22.12 (its package.json); shopify/shopify-api-php
  "php": "^8.1"; Kyon147/laravel-shopify "php": "^8.2".
-->
<config>
    <name>shopify</name>
    <tools>
        <language>
            <rule><version>hydrogen</version><value>nodejs</value></rule>
            <rule><version>app-remix</version><value>nodejs</value></rule>
            <default>php</default>
        </language>
        <php>
            <rule><version>hydrogen</version><value/></rule>
            <rule><version>app-remix</version><value/></rule>
            <rule><version>api-php</version><value>8.3</value></rule>
            <rule><version>laravel-shopify</version><value>8.3</value></rule>
            <default>8.2</default>
        </php>
        <db>
            <rule><version>hydrogen</version><value/></rule>
            <rule><version>app-remix</version><value/></rule>
            <rule><version>api-php</version><value>mariadb:11.4</value></rule>
            <rule><version>laravel-shopify</version><value>mariadb:11.4</value></rule>
            <default>11.1.2</default>
        </db>
        <composer>
            <rule><version>hydrogen</version><value/></rule>
            <rule><version>app-remix</version><value/></rule>
            <default>2</default>
        </composer>
        <redis>
            <rule><version>hydrogen</version><value/></rule>
            <rule><version>app-remix</version><value/></rule>
            <rule><version>api-php</version><value>7.4</value></rule>
            <rule><version>laravel-shopify</version><value>7.4</value></rule>
            <default>7.2.1</default>
        </redis>
        <valkey>
            <rule><version>hydrogen</version><value/></rule>
            <rule><version>app-remix</version><value/></rule>
            <rule><version>api-php</version><value/></rule>
            <rule><version>laravel-shopify</version><value/></rule>
            <default>8.1.3</default>
        </valkey>
        <rabbitmq>
            <rule><version>hydrogen</version><value/></rule>
            <rule><version>app-remix</version><value/></rule>
            <rule><version>api-php</version><value/></rule>
            <rule><version>laravel-shopify</version><value/></rule>
            <default>3.9.29</default>
        </rabbitmq>
        <nodejs>
            <rule><version>hydrogen</version><value>22.20.0</value></rule>
            <rule><version>app-remix</version><value>22.20.0</value></rule>
            <rule><version>api-php</version><value/></rule>
            <rule><version>laravel-shopify</version><value>22.20.0</value></rule>
            <default>18.15.0</default>
        </nodejs>
        <yarn>
            <rule><version>hydrogen</version><value>1.22.22</value></rule>
            <rule><version>app-remix</version><value>1.22.22</value></rule>
            <rule><version>api-php</version><value/></rule>
            <rule><version>laravel-shopify</version><value>1.22.22</value></rule>
            <default>3.6.4</default>
        </yarn>
    </tools>
    <presets>
        <preset>
            <version>hydrogen</version>
            <name>Hydrogen (Node.js storefront)</name>
            <description>Official headless storefront — Remix on Vite, Node {nodejs}, TypeScript. Deploys to Shopify Oxygen.</description>
        </preset>
        <preset>
            <version>app-remix</version>
            <name>Shopify App (Node.js / Remix)</name>
            <description>Official embedded app template — Remix + Prisma + App Bridge, Node {nodejs}, TypeScript.</description>
        </preset>
        <preset>
            <version>api-php</version>
            <name>PHP API SDK (shopify-api-php)</name>
            <description>Backend integration via official shopify/shopify-api Composer package. PHP {php}, MariaDB, Redis.</description>
        </preset>
        <preset>
            <version>laravel-shopify</version>
            <name>Laravel Shopify App (Kyon147/laravel-shopify)</name>
            <description>Full embedded Shopify App on Laravel — OAuth, billing, webhooks, AppBridge wired. PHP {php}, MariaDB, Redis, Node for assets.</description>
        </preset>
    </presets>
</config>
