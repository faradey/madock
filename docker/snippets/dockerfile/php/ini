RUN sed -i 's/session.cookie_lifetime = 0/session.cookie_lifetime = {{{.php.ini.session_cookie_lifetime}}}/g' /etc/php/{{{.php.version}}}/fpm/php.ini \
    && sed -i 's/post_max_size = 8M/post_max_size = {{{.php.ini.post_max_size}}}/g' /etc/php/{{{.php.version}}}/fpm/php.ini \
    && sed -i 's/upload_max_filesize = 2M/upload_max_filesize = {{{.php.ini.upload_max_filesize}}}/g' /etc/php/{{{.php.version}}}/fpm/php.ini \
    && sed -i 's/;max_input_vars = 1000/max_input_vars = {{{.php.ini.max_input_vars}}}/g' /etc/php/{{{.php.version}}}/fpm/php.ini

# How long a session file may sit unused before it is deleted. On Debian PHP's
# own garbage collection is off (gc_probability = 0) and /etc/cron.d/php runs
# sessionclean twice an hour instead, which removes every file in the session
# directory idle longer than this value. It reads the value from both the fpm
# and the cli php.ini and takes the larger, so both are written: setting only
# fpm would leave the cli's 1440 in charge.
#
# This is what logged a Magento admin out after 24 minutes with
# admin/security/session_lifetime set to ten days. The application's lifetime
# only decides when it stops trusting a session; the file was already gone.
# Irrelevant when sessions live in Redis or the application keeps its own
# session directory — sessionclean looks only at session.save_path.
RUN sed -i 's/^session.gc_maxlifetime = .*/session.gc_maxlifetime = {{{.php.ini.session_gc_maxlifetime}}}/' /etc/php/{{{.php.version}}}/fpm/php.ini \
    && sed -i 's/^session.gc_maxlifetime = .*/session.gc_maxlifetime = {{{.php.ini.session_gc_maxlifetime}}}/' /etc/php/{{{.php.version}}}/cli/php.ini

# sendmail_path is not set here: it is the last step of the image, in
# snippets/dockerfile/php/footer, because it is the one line that differs
# between projects built from the same template.
