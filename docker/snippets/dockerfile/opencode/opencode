FROM {{{.opencode.nodejs_repository}}}:{{{.opencode.nodejs_version}}}

# ripgrep: opencode's glob and grep tools run rg, and fail without it.
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client ripgrep \
    && rm -rf /var/lib/apt/lists/*
# Pinned by opencode/version: the version is in the command, so changing it
# rebuilds this layer instead of reusing whatever the cache last installed.
RUN npm install -g @opencode/cli@{{{.opencode.version}}}

# madock's configuration has to win over the project's own. A project that
# commits an opencode.json for its developers' machines names their providers —
# ollama on 127.0.0.1, say — and opencode reads a project file over
# OPENCODE_CONFIG, so the sandbox talked to an address it cannot reach.
# OPENCODE_CONFIG_CONTENT is read last. This wrapper sits ahead of the real
# binary in PATH, so every start — and the background service a client starts —
# carries it; the project's own instructions and tools still merge in.
RUN cat > /usr/local/sbin/opencode <<'MADOCK_EOF' && chmod 755 /usr/local/sbin/opencode
#!/bin/sh
OPENCODE_CONFIG_CONTENT=$(cat /etc/madock-opencode/opencode.json)
export OPENCODE_CONFIG_CONTENT
exec /usr/local/bin/opencode "$@"
MADOCK_EOF

RUN rm -f /var/log/faillog && rm -f /var/log/lastlog

RUN usermod -u {{{.os.user.uid}}} -o node && groupmod -g {{{.os.user.guid}}} -o node
RUN usermod -u {{{.os.user.uid}}} -o www-data && groupmod -g {{{.os.user.guid}}} -o www-data

# The project's tools live in opencode-exec. madock-exec runs a command there,
# in the directory it was called from: both containers mount the code at the
# same path, so the directory exists on the other side too.
RUN mkdir -p /etc/ssh/ssh_config.d && cat > /etc/ssh/ssh_config.d/madock-opencode.conf <<'MADOCK_EOF'
Host opencode-exec
    User opencode
    IdentityFile /etc/madock-opencode/id_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile /etc/madock-opencode/known_hosts
    StrictHostKeyChecking yes
    LogLevel ERROR
MADOCK_EOF
RUN cat > /usr/local/bin/madock-exec <<'MADOCK_EOF' && chmod 755 /usr/local/bin/madock-exec
#!/bin/bash
if [ $# -eq 0 ]; then
    echo "usage: madock-exec <command> [args...]" >&2
    exit 64
fi
dir=$PWD
case "$dir" in
    /var/www/html|/var/www/html/*) ;;
    *) dir={{{.workdir}}} ;;
esac
exec ssh -T opencode-exec "cd $(printf '%q' "$dir") && exec $(printf '%q ' "$@")"
MADOCK_EOF
# One shim, linked under every tool's name: it runs the name it was called by.
# bin/magento and other scripts need no shim of their own — their shebang
# finds php here.
RUN printf '#!/bin/bash\nexec /usr/local/bin/madock-exec "$(basename "$0")" "$@"\n' > /usr/local/bin/madock-exec-shim \
    && chmod 755 /usr/local/bin/madock-exec-shim \
    && for tool in php composer go gofmt python python3 pip pip3 ruby bundle rake; do ln -sf madock-exec-shim /usr/local/bin/$tool; done

WORKDIR {{{.workdir}}}

RUN chown {{{.os.user.uid}}}:{{{.os.user.guid}}} /var/www \
    && mkdir -p /var/www/.local/share/opencode \
    && chown -R {{{.os.user.uid}}}:{{{.os.user.guid}}} /var/www/.local

CMD ["sleep", "infinity"]
