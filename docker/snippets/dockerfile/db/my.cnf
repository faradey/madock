[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4

[mysqld]
innodb_file_per_table = 1
collation-server = utf8mb4_unicode_ci
init-connect='SET NAMES utf8mb4'
character-set-server = utf8mb4
wait_timeout=30000
innodb_buffer_pool_size = {{{memShare .db.memory 2 3 "M"}}}
innodb_log_buffer_size = {{{memShare .db.memory 1 3 "M"}}}
innodb_write_io_threads = 16
innodb_flush_log_at_trx_commit = 0
log_bin_trust_function_creators = 1
max_allowed_packet = 64M

{{{- if .logs.persist.enabled}}}
# The slow query log, which was never configured at all. `log_slow_query`,
# `general_log` and `log_error` are all commented out in the shipped config, so
# a slow query on any madock project has never been recorded anywhere. Two
# seconds is the threshold a person would set by hand on the day they finally
# needed it.
slow_query_log = 1
slow_query_log_file = /var/log/madock/mysql-slow.log
long_query_time = 2

# `log_error` is deliberately NOT set here, and the first attempt did set it.
#
# MariaDB writes its error log to a file or to stderr, never both, so pointing
# it at the mounted file empties the container's stream — and that stream is
# what `madock logs -s db` shows. The trade was described as deliberate and was
# simply bad: it takes away the command everybody uses to read the database, to
# gain a file whose contents are mostly startup notes. CI found it twice in one
# run: `the database never wrote anything recognisable to its log`, and a
# project whose database never became ready at all.
#
# What was worth having from that change is the slow query log above, which
# costs the stream nothing.
{{{- end}}}

sql_mode=NO_ENGINE_SUBSTITUTION,STRICT_TRANS_TABLES
