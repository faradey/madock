<?xml version="1.0" encoding="UTF-8"?>
<config>
    <activeScope>default</activeScope>
    <!-- Whether commands that delete a project's data may run here.

         Outside <scopes> on purpose. Everything below describes a project: a
         project's own file overrides it and `config:set` writes it. A guard a
         project can switch off is not a guard, and `config:set` writes to the
         project — so the switch would be reachable by the very command it
         protects against. Here it can only be changed by editing this file.

         It is a guard rail, not a security control: the file sits beside the
         binary and is writable by the same user. It stops a mistake, not a
         person.

         What it covers is what cannot be undone: `project:remove`, which ends
         with a recursive delete of the working directory, and `prune` when it
         is asked to take the volumes, which destroys the database with them.
         Plain `prune` is `docker compose down` and is deliberately not covered,
         because `start` puts that back.

         (No double hyphen anywhere above: XML forbids one inside a comment, and
         naming the flag here cost a test run to find that out.)

         true here, false in madock-pro, which is the edition that runs on
         servers. -->
    <allow_destructive_commands>true</allow_destructive_commands>
    <scopes>
        <default>
            <name>default</name>
            <os>
                <name>ubuntu</name>
                <version>22.04</version>
            </os>
            <nginx>
                <!-- A project that answers no request needs no web server: a queue
                     worker, a bus consumer, the owner of a shared database schema.
                     false leaves out the container, the vhost, the block in the
                     shared proxy, the name in the certificate and the ports. -->
                <enabled>true</enabled>
                <port>
                    <unsecure>80</unsecure>
                    <secure>443</secure>
                    <internal>80</internal>
                </port>
                <!--<hosts>
                    <base>
                        <name>example.com</name>
                    </base>
                </hosts>-->
                <ssl>
                    <enabled>true</enabled>
                </ssl>
                <http>
                    <version>http2</version>
                </http>
                <run_type>website</run_type>
                <default_host_first_level>.test</default_host_first_level>
                <interface_ip></interface_ip>
            </nginx>
            <platform>magento2</platform>
            <workdir>/var/www/html</workdir>
            <public_dir>public</public_dir>
            <composer_dir></composer_dir>
            <timezone>UTC</timezone>
            <php>
                <enabled>false</enabled>
                <version>8.2</version>
                <composer>
                    <version>2</version>
                </composer>
                <xdebug>
                    <version>3</version>
                    <ide_key>PHPSTORM</ide_key>
                    <remote_host>host.docker.internal</remote_host>
                    <enabled>false</enabled>
                    <mode>debug</mode>
                </xdebug>
                <ioncube>
                    <enabled>false</enabled>
                </ioncube>
                <!-- Where PHP's mail() hands the message. The defaults point at
                     mailpit, which is where a developer wants it. On a server
                     that actually sends mail, point it at the relay on the host
                     instead (port 25 for a local postfix), or turn it off and
                     let the application speak SMTP itself. Editing php.ini
                     inside the container is not an option that survives: the
                     image is rebuilt from a template and the edit goes with
                     it. -->
                <sendmail>
                    <enabled>true</enabled>
                    <host>host.docker.internal</host>
                    <port>1025</port>
                    <!-- Envelope sender. Empty by default because no address is
                         right for every project, and a wrong one hurts
                         deliverability more than a clear failure does. Set it
                         and a plain mail() call works; leave it and only callers
                         that pass their own sender (Magento, Laravel, anything
                         using a mail transport) can send. -->
                    <from></from>
                </sendmail>
                <browser_libs>false</browser_libs>
            </php>
            <db>
                <enabled>true</enabled>
                <type>mysql</type>
                <!-- Memory budget for the database engine, divided by whichever
                     engine reads it: MySQL takes two thirds as its buffer pool
                     and one third as its log buffer, PostgreSQL a quarter as
                     shared_buffers and three quarters as effective_cache_size,
                     MongoDB a half as its WiredTiger cache. 768M reproduces the
                     numbers that used to be written into my.cnf by hand.
                     MongoDB is the one worth raising deliberately: left to
                     itself it sizes its cache from the host's RAM, not from the
                     container's limit. -->
                <memory>768M</memory>
                <repository>mariadb</repository>
                <root_password>password</root_password>
                <user>db</user>
                <password>db</password>
                <database>db</database>
                <phpmyadmin>
                    <enabled>false</enabled>
                    <repository>phpmyadmin/phpmyadmin</repository>
                    <version>5.2.1</version>
                </phpmyadmin>
                <pgadmin>
                    <enabled>false</enabled>
                    <repository>dpage/pgadmin4</repository>
                    <version>latest</version>
                    <email>admin@admin.com</email>
                    <password>admin</password>
                </pgadmin>
                <mongo_express>
                    <enabled>false</enabled>
                    <repository>mongo-express</repository>
                    <version>latest</version>
                </mongo_express>
            </db>
            <db2>
                <enabled>false</enabled>
                <repository>mariadb</repository>
                <root_password>password</root_password>
                <user>db</user>
                <password>db</password>
                <database>db</database>
                <phpmyadmin>
                    <enabled>false</enabled>
                    <repository>phpmyadmin/phpmyadmin</repository>
                    <version>5.2.1</version>
                </phpmyadmin>
            </db2>
            <nodejs>
                <!-- A container of its own, running the project's node process. -->
                <enabled>false</enabled>
                <!-- Node inside the application container instead, whatever
                     language that container runs. It was php/nodejs/enabled
                     until 3.9.8, which said node was php's business; it is not.
                     A Python or Go service with a JavaScript front end needs the
                     same thing, and the version above was already shared. The
                     two are independent: a project can have both.

                     Shaped as <embedded><enabled> rather than a bare <embedded>
                     so it is an ordinary service switch. The short form cost a
                     special case in four places and made service:list omit it
                     silently, which is worse than not being settable at all. -->
                <embedded>
                    <enabled>false</enabled>
                </embedded>
                <repository>node</repository>
                <version>18.15.0</version>
                <env>development</env>
                <script></script>
                <script_type>auto</script_type>
                <browser_libs>false</browser_libs>
                <yarn>
                    <enabled>false</enabled>
                    <version>1.22.19</version>
                </yarn>
            </nodejs>
            <search>
                <engine>elasticsearch</engine>
                <elasticsearch>
                    <enabled>false</enabled>
                    <repository>elasticsearch</repository>
                    <version>8.4.3</version>
                    <auth>
                        <enabled>false</enabled>
                        <user></user>
                        <password></password>
                    </auth>
                    <dashboard>
                        <enabled>false</enabled>
                        <repository>kibana</repository>
                    </dashboard>
                </elasticsearch>
                <opensearch>
                    <enabled>false</enabled>
                    <repository>opensearchproject/opensearch</repository>
                    <version>2.19.1</version>
                    <auth>
                        <enabled>false</enabled>
                        <user></user>
                        <password></password>
                    </auth>
                    <dashboard>
                        <enabled>false</enabled>
                        <repository>opensearchproject/opensearch-dashboards</repository>
                    </dashboard>
                </opensearch>
                <meilisearch>
                    <enabled>false</enabled>
                    <repository>getmeili/meilisearch</repository>
                    <version>1.11.3</version>
                    <master_key>masterKey</master_key>
                </meilisearch>
            </search>
            <redis>
                <enabled>false</enabled>
                <repository>redis</repository>
                <version>7.2.3</version>
                <auth>
                    <enabled>false</enabled>
                    <password></password>
                </auth>
            </redis>
            <valkey>
                <enabled>false</enabled>
                <repository>valkey/valkey</repository>
                <version>8.1.3</version>
                <auth>
                    <enabled>false</enabled>
                    <password></password>
                </auth>
            </valkey>
            <memcached>
                <enabled>false</enabled>
                <repository>memcached</repository>
                <version>1.6.39-alpine</version>
                <memory>256</memory>
                <max_connections>1024</max_connections>
            </memcached>
            <rabbitmq>
                <enabled>false</enabled>
                <repository>rabbitmq</repository>
                <version>3.12.10</version>
                <user>guest</user>
                <password>guest</password>
            </rabbitmq>
            <artemis>
                <enabled>false</enabled>
                <repository>apache/activemq-artemis</repository>
                <version>2.42.0</version>
                <user>artemis</user>
                <password>artemis</password>
            </artemis>
            <worker>
                <!--
                    Long-running processes as container services, one per named
                    entry. Any platform: the image is the project's main service,
                    so the worker gets the runtime the application has.

                    The user element applies to all of them and is usually needed
                    on PHP images, where the application runs as www-data.

                    A programs block holds one element per worker, its text the
                    command: for example a program named "queue" whose command is
                    "php artisan queue:work redis", or one named "consumer"
                    running "php bin/console messenger:consume async".
                -->
                <enabled>false</enabled>
                <user></user>
            </worker>
            <cron>
                <enabled>false</enabled>
                <!--<jobs>
                    <job>* * * * * cd /var/www/html &amp;&amp; php bin/console scheduled:run</job>
                </jobs>-->
            </cron>
            <ssh>
                <auth_type>key</auth_type>
                <host></host>
                <port>22</port>
                <username></username>
                <key_path></key_path>
                <password></password>
                <site_root_path></site_root_path>
            </ssh>
            <magento>
                <admin_first_name>admin</admin_first_name>
                <admin_last_name>admin</admin_last_name>
                <admin_email>admin@admin.com</admin_email>
                <admin_user>admin</admin_user>
                <admin_password>admin123</admin_password>
                <admin_frontname>admin</admin_frontname>
                <locale>en_US</locale>
                <currency>USD</currency>
                <timezone>America/Chicago</timezone>
                <mftf>
                    <enabled>false</enabled>
                    <admin_user>admin</admin_user>
                    <otp_shared_secret>MFZWIZTHNBVGW3D2</otp_shared_secret>
                </mftf>
                <cloud>
                    <enabled>false</enabled>
                    <username></username>
                    <password></password>
                    <project_name></project_name>
                </cloud>
                <n98magerun>
                    <enabled>false</enabled>
                </n98magerun>
            </magento>
            <shopware>
                <messenger>
                    <enabled>false</enabled>
                </messenger>
                <!-- shopware-cli, the vendor's extension tooling. Off by
                     default and downloaded into the php image when enabled, the
                     same way magento/n98magerun is: it is a compiled Go binary,
                     not something composer can put in the project. The version
                     is the vendor's release tag, which carries no `v` prefix. -->
                <cli>
                    <enabled>false</enabled>
                    <version>0.17.3</version>
                </cli>
            </shopware>
            <medusa>
                <storefront>
                    <enabled>true</enabled>
                    <repository>node</repository>
                    <version>20.18.0</version>
                    <path>storefront</path>
                    <workdir>/var/www/html/storefront</workdir>
                    <region>gb</region>
                    <git_url>https://github.com/medusajs/nextjs-starter-medusa.git</git_url>
                </storefront>
            </medusa>
            <saleor>
                <dashboard>
                    <enabled>false</enabled>
                    <repository>ghcr.io/saleor/saleor-dashboard</repository>
                    <version>3.23</version>
                    <api_url>https://loc.local.test/graphql/</api_url>
                </dashboard>
                <worker>
                    <enabled>false</enabled>
                </worker>
            </saleor>
            <spree>
                <sidekiq>
                    <enabled>false</enabled>
                </sidekiq>
                <storefront>
                    <enabled>true</enabled>
                    <repository>node</repository>
                    <version>22.20.0</version>
                    <path>storefront</path>
                    <workdir>/var/www/html/storefront</workdir>
                    <country>us</country>
                    <locale>en</locale>
                    <store_name>Spree Store</store_name>
                    <git_url>https://github.com/spree/storefront.git</git_url>
                </storefront>
            </spree>
            <sylius>
                <messenger>
                    <enabled>false</enabled>
                </messenger>
                <encore>
                    <enabled>false</enabled>
                </encore>
            </sylius>
            <proxy>
                <enabled>true</enabled>
                <timeout>
                    <connect>60</connect>
                    <send>300</send>
                    <read>300</read>
                </timeout>
                <gzip>
                    <enabled>true</enabled>
                </gzip>
                <!-- Requests per second per client address, and how many may
                     arrive ahead of that rate before nginx refuses.

                     It used to be 1000/2000, which is not a limit but a
                     permission: it was written to catch a request loop, not an
                     attacker, and the comment in the code said so. 50 with a
                     burst of 200 still passes an asset-heavy page in one go —
                     a browser opens a handful of connections and a Magento
                     page pulls a few dozen files — while a single address can
                     no longer occupy the machine on its own.

                     It is per address, so it does nothing against a
                     distributed flood. Nothing on this side of the wire does;
                     that is what a proxy in front of the origin is for. -->
                <rate_limit>
                    <enabled>true</enabled>
                    <rate>50</rate>
                    <burst>200</burst>
                </rate_limit>
                <!-- Simultaneous connections per client address. Missing
                     entirely until now, which left the slow half of resource
                     exhaustion unanswered: a request that never finishes costs
                     no rate at all, and a few hundred of them hold every worker
                     the proxy has. A browser needs six to eight per host, so
                     100 is generous. -->
                <conn_limit>
                    <enabled>true</enabled>
                    <per_ip>100</per_ip>
                </conn_limit>
                <!-- The largest request body the proxy will accept. It was 2G,
                     hard-coded in every server block, which is an upload nobody
                     makes through a browser and a cheap way to occupy disk and
                     workers. 128M covers product images and admin imports; a
                     project that genuinely needs more sets its own. -->
                <max_body_size>128M</max_body_size>
                <!-- Whether the shared proxy publishes its two fixed
                     development ports: LiveReload on 35729 and Vite on 5173.

                     `publish` rather than `enabled`, because that is all it
                     does. Turning one off does not turn the tool off: the
                     project still runs Vite and still publishes its own
                     allocated port, which the firewall guard covers. What goes
                     away is the proxy's fixed entry point — the one that routes
                     by Host so a developer can use the same number for every
                     project. The neighbouring `mailpit/enabled` means something
                     else entirely: there it decides whether a container exists
                     at all.

                     They are fixed numbers, so they fall outside the
                     17000-19999 range the firewall guard closes, and they are
                     published whether or not anything can serve them — Vite
                     needs nodejs, which a project may not run at all. On a
                     laptop that is harmless and convenient; on a server it is
                     a development server answering the internet, which is how
                     one was found listening on a production host. -->
                <livereload>
                    <publish>true</publish>
                </livereload>
                <vite>
                    <publish>true</publish>
                </vite>
                <mailpit>
                    <enabled>true</enabled>
                    <!-- Which address the web interface is published on. It has
                         no authentication and shows every message every project
                         has sent, so the default is loopback: on a laptop the
                         browser is on the same machine, and on a server this is
                         reached through an ssh tunnel. Empty means all
                         interfaces, which on a server means anyone. -->
                    <interface_ip>127.0.0.1:</interface_ip>
                </mailpit>
            </proxy>
            <container_name_prefix>madock_</container_name_prefix>
            <isolation>
                <enabled>false</enabled>
            </isolation>
            <permissions>
                <umask>
                    <permissive>true</permissive>
                </umask>
            </permissions>
            <varnish>
                <enabled>false</enabled>
                <repository>varnish</repository>
                <version>7.5.0</version>
                <config_file>default.vcl</config_file>
            </varnish>
            <grafana>
                <enabled>false</enabled>
                <repository>grafana/grafana</repository>
                <version>11.1.5</version>
                <auth>
                    <enabled>false</enabled>
                    <user></user>
                    <password></password>
                </auth>
            </grafana>
